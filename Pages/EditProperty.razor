@page "/properties/edit/{Id:int}"

@using Microsoft.AspNetCore.Components.Forms
@using REAL_ESTATE_CLEAN.Core.Application.DTO
@using REAL_ESTATE_CLEAN.Core.Application.Services
@using REAL_ESTATE_CLEAN.Core.Persistence
@using REAL_ESTATE_CLEAN.Infrastructure.Auth
@using Microsoft.EntityFrameworkCore

@inject PropertyService PropertyService
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav
@inject AppDbContext Db

<h1>✏️ İlan Düzenle</h1>

@if (loading)
{
    <p>İlan yükleniyor...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <p class="error">@error</p>
}
else if (property is not null)
{
    <div class="form">

        <div>
            <label>İlan Başlığı</label>

            <input
                @bind="title"
                placeholder="İlan başlığı" />
        </div>

        <div>
            <label>Konum</label>

            <input
                @bind="location"
                placeholder="Konum" />
        </div>

        <div>
            <label>Şehir</label>

            <input
                @bind="city"
                placeholder="Şehir" />
        </div>

        <div>
            <label>Fiyat</label>

            <input
                type="number"
                @bind="price"
                step="0.01" />
        </div>

        <div class="checkbox">

            <input
                type="checkbox"
                @bind="isPremium" />

            <label>⭐ Premium İlan</label>

        </div>

        <button
            @onclick="Save"
            disabled="@saving">

            @(saving
                ? "Kaydediliyor..."
                : "💾 Değişiklikleri Kaydet")

        </button>

    </div>

    <hr />

    <h2>📷 İlan Medyaları</h2>

    <div class="upload-section">

        <label>
            <strong>Fotoğraf Ekle</strong>
        </label>

        <InputFile
            OnChange="HandleImageFile"
            accept="image/jpeg,image/png,image/webp" />

        @if (imageFile is not null)
        {
            <p>
                Seçilen:
                <strong>@imageFile.Name</strong>
            </p>

            <button
                @onclick="UploadImage"
                disabled="@uploading">

                @(uploading
                    ? "Yükleniyor..."
                    : "📷 Fotoğrafı Yükle")

            </button>
        }

    </div>

    <div class="upload-section">

        <label>
            <strong>🔄 360° Görsel Ekle</strong>
        </label>

        <InputFile
            OnChange="HandlePanoramaFile"
            accept="image/jpeg,image/png,image/webp" />

        @if (panoramaFile is not null)
        {
            <p>
                Seçilen:
                <strong>@panoramaFile.Name</strong>
            </p>

            <button
                @onclick="UploadPanorama"
                disabled="@uploading">

                @(uploading
                    ? "Yükleniyor..."
                    : "🔄 360° Görseli Yükle")

            </button>
        }

    </div>

    @if (media.Count > 0)
    {
        <h3>Mevcut Medyalar</h3>

        <div class="media-grid">

            @foreach (var item in media)
            {
                <div class="media-card">

                    @if (item.MediaType == "Image")
                    {
                        <img
                            src="@item.MediaUrl"
                            alt="@item.OriginalFileName" />
                    }
                    else if (item.MediaType == "Panorama360")
                    {
                        <div class="panorama-preview">
                            🔄 360°
                        </div>
                    }
                    else
                    {
                        <div class="panorama-preview">
                            🎬 @item.MediaType
                        </div>
                    }

                    <p>
                        @item.OriginalFileName
                    </p>

                    @if (item.IsPrimary)
                    {
                        <strong class="cover">
                            ⭐ Kapak Fotoğrafı
                        </strong>
                    }
                    else if (item.MediaType == "Image")
                    {
                        <button
                            @onclick="() => SetCover(item.Id)">

                            ⭐ Kapak Yap

                        </button>
                    }

                    <button
                        class="delete"
                        @onclick="() => DeleteMedia(item.Id)">

                        🗑️ Sil

                    </button>

                </div>
            }

        </div>
    }

    @if (!string.IsNullOrWhiteSpace(success))
    {
        <p class="success">
            @success
        </p>
    }

    <button
        class="back"
        @onclick="GoBack">

        ← İlanlara Dön

    </button>
}

<style>

.form {
    max-width: 650px;
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.form > div {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.form input {
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 16px;
}

.checkbox {
    flex-direction: row !important;
    align-items: center;
}

button {
    padding: 11px 18px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    margin-right: 8px;
    margin-top: 8px;
}

.upload-section {
    max-width: 650px;
    padding: 20px;
    margin: 15px 0;
    border: 1px solid #ddd;
    border-radius: 12px;
}

.media-grid {
    display: grid;
    grid-template-columns:
        repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
    margin-top: 20px;
}

.media-card {
    border: 1px solid #ddd;
    border-radius: 12px;
    padding: 12px;
}

.media-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 8px;
}

.panorama-preview {
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eee;
    border-radius: 8px;
    font-size: 35px;
}

.cover {
    display: block;
    margin: 8px 0;
}

.delete {
    background: #dc3545;
    color: white;
}

.back {
    margin-top: 25px;
}

.error {
    color: red;
}

.success {
    color: green;
}

</style>

@code {

    [Parameter]
    public int Id { get; set; }

    private PropertyDto? property;

    private string title = "";
    private string location = "";
    private string city = "";

    private decimal price;

    private bool isPremium;

    private bool loading = true;
    private bool saving;
    private bool uploading;

    private string error = "";
    private string success = "";

    private IBrowserFile? imageFile;
    private IBrowserFile? panoramaFile;

    private List<PropertyMedia> media = new();

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        error = "";
        success = "";

        try
        {
            if (!CurrentUser.IsAuthenticated)
            {
                Nav.NavigateTo("/login");
                return;
            }

            var userId =
                CurrentUser.UserId!.Value;

            var belongsToUser =
                await PropertyService.BelongsToUser(
                    Id,
                    userId);

            if (!belongsToUser)
            {
                error =
                    "Bu ilanı düzenleme yetkiniz yok.";

                return;
            }

            property =
                await PropertyService.GetById(Id);

            if (property is null)
            {
                error = "İlan bulunamadı.";
                return;
            }

            title = property.Title;
            location = property.Location;
            city = property.City;
            price = property.Price;
            isPremium = property.IsPremium;

            await LoadMedia();
        }
        catch (Exception ex)
        {
            error =
                "İlan yüklenirken hata oluştu: " +
                ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadMedia()
    {
        media = await Db.PropertyMedia
            .Where(x => x.PropertyId == Id)
            .OrderBy(x => x.DisplayOrder)
            .ThenBy(x => x.Id)
            .ToListAsync();
    }

    private void HandleImageFile(
        InputFileChangeEventArgs e)
    {
        imageFile = e.File;
        error = "";
    }

    private void HandlePanoramaFile(
        InputFileChangeEventArgs e)
    {
        panoramaFile = e.File;
        error = "";
    }

    private async Task Save()
    {
        error = "";
        success = "";

        if (string.IsNullOrWhiteSpace(title))
        {
            error = "İlan başlığı boş olamaz.";
            return;
        }

        if (string.IsNullOrWhiteSpace(location))
        {
            error = "Konum boş olamaz.";
            return;
        }

        if (string.IsNullOrWhiteSpace(city))
        {
            error = "Şehir boş olamaz.";
            return;
        }

        if (price <= 0)
        {
            error = "Fiyat 0'dan büyük olmalıdır.";
            return;
        }

        try
        {
            saving = true;

            var userId =
                CurrentUser.UserId!.Value;

            var updated =
                await PropertyService.UpdateByUserId(
                    Id,
                    userId,
                    title,
                    location,
                    city,
                    price,
                    isPremium);

            if (!updated)
            {
                error =
                    "İlan güncellenemedi veya size ait değil.";

                return;
            }

            success =
                "İlan bilgileri güncellendi.";

            property =
                await PropertyService.GetById(Id);
        }
        catch (Exception ex)
        {
            error =
                "Güncelleme hatası: " +
                ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task UploadImage()
    {
        if (imageFile is null)
            return;

        await UploadMedia(
            imageFile,
            "Image");

        imageFile = null;
    }

    private async Task UploadPanorama()
    {
        if (panoramaFile is null)
            return;

        await UploadMedia(
            panoramaFile,
            "Panorama360");

        panoramaFile = null;
    }

    private async Task UploadMedia(
        IBrowserFile file,
        string mediaType)
    {
        error = "";
        success = "";

        if (file.Size > 50 * 1024 * 1024)
        {
            error =
                "Dosya 50 MB'dan büyük olamaz.";

            return;
        }

        var extension =
            Path.GetExtension(file.Name)
                .ToLowerInvariant();

        if (extension != ".jpg" &&
            extension != ".jpeg" &&
            extension != ".png" &&
            extension != ".webp")
        {
            error =
                "Geçersiz görsel formatı.";

            return;
        }

        try
        {
            uploading = true;

            var folderName =
                mediaType == "Panorama360"
                    ? "360"
                    : "images";

            var folder = Path.Combine(
                Environment.CurrentDirectory,
                "wwwroot",
                "uploads",
                "properties",
                Id.ToString(),
                folderName);

            Directory.CreateDirectory(folder);

            var fileName =
                $"{Guid.NewGuid():N}{extension}";

            var filePath =
                Path.Combine(
                    folder,
                    fileName);

            await using var stream =
                new FileStream(
                    filePath,
                    FileMode.Create);

            await file
                .OpenReadStream(
                    50 * 1024 * 1024)
                .CopyToAsync(stream);

            var url =
                $"/uploads/properties/{Id}/{folderName}/{fileName}";

            var propertyMedia =
                new PropertyMedia
                {
                    PropertyId = Id,
                    MediaType = mediaType,
                    MediaUrl = url,
                    IsPrimary =
                        mediaType == "Image" &&
                        !media.Any(x =>
                            x.MediaType == "Image" &&
                            x.IsPrimary),
                    DisplayOrder =
                        media.Count,
                    OriginalFileName = file.Name,
                    ContentType = file.ContentType,
                    SizeBytes = file.Size
                };

            Db.PropertyMedia.Add(propertyMedia);

            await Db.SaveChangesAsync();

            await LoadMedia();

            success =
                mediaType == "Panorama360"
                    ? "360° görsel başarıyla yüklendi."
                    : "Fotoğraf başarıyla yüklendi.";
        }
        catch (Exception ex)
        {
            error =
                "Medya yükleme hatası: " +
                ex.Message;
        }
        finally
        {
            uploading = false;
        }
    }

    private async Task DeleteMedia(int mediaId)
    {
        error = "";
        success = "";

        var userId =
            CurrentUser.UserId!.Value;

        var deleted =
            await PropertyService.DeleteMediaByUserId(
                mediaId,
                userId);

        if (!deleted)
        {
            error =
                "Bu medyayı silme yetkiniz yok.";

            return;
        }

        await LoadMedia();

        success =
            "Medya silindi.";
    }

    private async Task SetCover(int mediaId)
    {
        error = "";
        success = "";

        var userId =
            CurrentUser.UserId!.Value;

        var result =
            await PropertyService.SetCoverMediaByUserId(
                mediaId,
                userId);

        if (!result)
        {
            error =
                "Kapak fotoğrafı değiştirilemedi.";

            return;
        }

        await LoadMedia();

        success =
            "Kapak fotoğrafı değiştirildi.";
    }

    private void GoBack()
    {
        Nav.NavigateTo("/properties");
    }
}

