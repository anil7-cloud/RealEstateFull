@attribute [Authorize(Roles = "Admin")]
@page "/admin/dashboard"

@using REAL_ESTATE_CLEAN.Core.Persistence
@using REAL_ESTATE_CLEAN.Core.Application.Services

@inject PropertyService PropertyService

<h1>🛡️ Admin İlan Moderasyonu</h1>

@if (loading)
{
    <p>İlanlar yükleniyor...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="error">@error</div>
}
else if (properties.Count == 0)
{
    <div class="empty">
        Henüz ilan bulunmuyor.
    </div>
}
else
{
    <div class="stats">
        <div>
            <strong>@properties.Count</strong>
            <span>Toplam İlan</span>
        </div>

        <div>
            <strong>@properties.Count(x => x.IsActive)</strong>
            <span>Aktif</span>
        </div>

        <div>
            <strong>@properties.Count(x => !x.IsActive)</strong>
            <span>Pasif</span>
        </div>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>İlan</th>
                    <th>Şehir</th>
                    <th>İlçe</th>
                    <th>Fiyat</th>
                    <th>Durum</th>
                    <th>İşlem</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var property in properties)
                {
                    <tr>
                        <td>
                            <strong>@property.Title</strong>
                        </td>

                        <td>@property.City</td>

                        <td>@property.District</td>

                        <td>
                            @property.Price.ToString("N0") ₺
                        </td>

                        <td>
                            @if (property.IsActive)
                            {
                                <span class="active">
                                    🟢 Aktif
                                </span>
                            }
                            else
                            {
                                <span class="passive">
                                    🔴 Pasif
                                </span>
                            }
                        </td>

                        <td>
                            @if (property.IsActive)
                            {
                                <button
                                    class="danger"
                                    @onclick="() => SetStatus(property.Id, false)">
                                    🚫 Pasife Al
                                </button>
                            }
                            else
                            {
                                <button
                                    class="success"
                                    @onclick="() => SetStatus(property.Id, true)">
                                    ✅ Aktifleştir
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<style>
.stats {
    display: grid;
    grid-template-columns:
        repeat(auto-fit, minmax(180px, 1fr));
    gap: 18px;
    margin: 25px 0;
}

.stats > div {
    padding: 22px;
    border: 1px solid #ddd;
    border-radius: 14px;
    background: #fafafa;
}

.stats strong {
    display: block;
    font-size: 30px;
}

.stats span {
    color: #666;
}

.table-container {
    width: 100%;
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    background: white;
}

th,
td {
    border: 1px solid #ddd;
    padding: 13px;
    text-align: left;
}

th {
    background: #f5f5f5;
}

.active {
    color: green;
    font-weight: 600;
}

.passive {
    color: #b00020;
    font-weight: 600;
}

button {
    border: none;
    border-radius: 8px;
    padding: 9px 14px;
    cursor: pointer;
}

.danger {
    background: #dc3545;
    color: white;
}

.success {
    background: #198754;
    color: white;
}

.error,
.empty {
    padding: 25px;
    border-radius: 12px;
    background: #f5f5f5;
}

.error {
    color: #b00020;
}

@@media (max-width: 700px) {
    th,
    td {
        white-space: nowrap;
    }
}
</style>

@code {
    private List<Property> properties = new();
    private bool loading = true;
    private string error = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadProperties();
    }

    private async Task LoadProperties()
    {
        loading = true;

        try
        {
            properties =
                await PropertyService.GetAllForAdmin();
        }
        catch (Exception ex)
        {
            error = "İlanlar yüklenirken hata oluştu.";
            Console.WriteLine(ex);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SetStatus(
        int propertyId,
        bool isActive)
    {
        var result =
            await PropertyService.SetActiveByAdmin(
                propertyId,
                isActive);

        if (!result)
        {
            error = "İlan durumu değiştirilemedi.";
            return;
        }

        await LoadProperties();
    }
}
