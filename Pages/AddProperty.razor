@using REAL_ESTATE_CLEAN.Infrastructure.Auth
@inject CurrentUserService CurrentUser
@using Microsoft.AspNetCore.Components.Forms
@page "/add-property"

@using REAL_ESTATE_CLEAN.Core.Persistence
@using Microsoft.EntityFrameworkCore

@inject AppDbContext Db
@inject NavigationManager Nav

<h3>🏠 Yeni İlan Ekle</h3>

<div class="form">

    <div>
        <label>İlan Başlığı</label>
        <input @bind="title"
               placeholder="Örn: 3+1 Lüks Daire" />
    </div>

    <div>
        <label>Konum</label>
        <input @bind="location"
               placeholder="Örn: Çankaya, Kızılay" />
    </div>

    <div>
        <label>Şehir</label>
        <input @bind="city"
               placeholder="Örn: Ankara" />
    </div>

    <div>
        <label>Fiyat</label>
        <input @bind="price"
               type="number"
               step="0.01"
               placeholder="Örn: 5000000" />
    </div>

    <div class="checkbox">
        <input type="checkbox"
               @bind="isPremium" />
        <label>Premium İlan</label>
    </div>

    <div class="panorama-upload">
        <label><strong>🔄 360° Görsel</strong></label>

        <InputFile
            OnChange="HandlePanoramaFile"
            accept="image/jpeg,image/png,image/webp" />

        <p>360° kamera ile çekilmiş panoramik görsel seçin.</p>

        @if (panoramaFile is not null)
        {
            <p>Seçilen: <strong>@panoramaFile.Name</strong></p>
        }
    </div>

    <button @onclick="SaveProperty"
            disabled="@isSaving">

        @(isSaving ? "Kaydediliyor..." : "İlanı Ekle")

    </button>

</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <p class="error">@error</p>
}

@if (!string.IsNullOrWhiteSpace(success))
{
    <p class="success">@success</p>
}

@code {

    private string title = "";
    private string location = "";
    private string city = "";
    private decimal price;

    private bool isPremium;
    private bool isSaving;

    private string error = "";
    private string success = "";
    private IBrowserFile? panoramaFile;

    private void HandlePanoramaFile(InputFileChangeEventArgs e)
    {
        panoramaFile = e.File;
        error = "";
    }

    private async Task SaveProperty()
    {
        error = "";
        success = "";

        if (string.IsNullOrWhiteSpace(title))
        {
            error = "İlan başlığı boş olamaz.";
            return;
        }

        if (string.IsNullOrWhiteSpace(location))
        {
            error = "Konum boş olamaz.";
            return;
        }

        if (string.IsNullOrWhiteSpace(city))
        {
            error = "Şehir boş olamaz.";
            return;
        }

        if (price <= 0)
        {
            error = "Fiyat 0'dan büyük olmalıdır.";
            return;
        }

        try
        {
            isSaving = true;

            var property = new Property
            {
                Title = title.Trim(),
                Location = location.Trim(),
                City = city.Trim(),
                Price = price,
                IsPremium = isPremium,
                IsActive = true,
                ViewCount = 0,
                CreatedAt = DateTime.UtcNow,
                AppUserId = CurrentUser.UserId!.Value
            };

            /*
             * Önce ilanı kaydediyoruz.
             * Böylece EF Core gerçek Property.Id değerini oluşturuyor.
             */
            Db.Properties.Add(property);
            await Db.SaveChangesAsync();

            Console.WriteLine(
                $"PROPERTY CREATED: Id={property.Id}, Title={property.Title}");

            /*
             * 360° görsel gerçekten kullanıcı tarafından seçildiyse
             * gerçek Property.Id ile kaydedilir.
             */
            if (panoramaFile is not null)
            {
                if (panoramaFile.Size > 50 * 1024 * 1024)
                {
                    error = "360° görsel 50 MB'dan büyük olamaz.";
                    return;
                }

                var extension =
                    Path.GetExtension(panoramaFile.Name)
                    .ToLowerInvariant();

                if (extension != ".jpg" &&
                    extension != ".jpeg" &&
                    extension != ".png" &&
                    extension != ".webp")
                {
                    error = "Geçersiz 360° görsel formatı.";
                    return;
                }

                var panoramaFolder = Path.Combine(
                    Environment.CurrentDirectory,
                    "wwwroot",
                    "uploads",
                    "properties",
                    property.Id.ToString(),
                    "360");

                Directory.CreateDirectory(panoramaFolder);

                var panoramaFileName =
                    $"{Guid.NewGuid():N}{extension}";

                var panoramaPath =
                    Path.Combine(
                        panoramaFolder,
                        panoramaFileName);

                await using var panoramaStream =
                    new FileStream(
                        panoramaPath,
                        FileMode.Create);

                await panoramaFile
                    .OpenReadStream(50 * 1024 * 1024)
                    .CopyToAsync(panoramaStream);

                var panoramaUrl =
                    $"/uploads/properties/{property.Id}/360/{panoramaFileName}";

                var panoramaMedia = new PropertyMedia
                {
                    PropertyId = property.Id,
                    MediaType = "Panorama360",
                    MediaUrl = panoramaUrl,
                    IsPrimary = false,
                    DisplayOrder = 0,
                    OriginalFileName = panoramaFile.Name,
                    ContentType = panoramaFile.ContentType,
                    SizeBytes = panoramaFile.Size
                };

                Db.PropertyMedia.Add(panoramaMedia);

                await Db.SaveChangesAsync();

                Console.WriteLine(
                    $"PANORAMA360 SAVED: PropertyId={property.Id}, Url={panoramaUrl}");
            }

            success =
                $"İlan başarıyla kaydedildi. İlan ID: {property.Id}";

            title = "";
            location = "";
            city = "";
            price = 0;
            isPremium = false;
            panoramaFile = null;
        }
        catch (Exception ex)
        {
            error =
                "İlan kaydedilirken hata oluştu: " +
                ex.Message;

            Console.WriteLine(
                $"PROPERTY SAVE ERROR: {ex}");
        }
        finally
        {
            isSaving = false;
        }
    }
}

<style>

.form {
    max-width: 600px;
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.form div {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.form input[type="text"],
.form input[type="number"],
.form input:not([type]) {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 16px;
}

.checkbox {
    flex-direction: row !important;
    align-items: center;
    gap: 8px !important;
}

button {
    width: fit-content;
    padding: 11px 20px;
    border: none;
    border-radius: 8px;
    background: #5b6cff;
    color: white;
    cursor: pointer;
    font-size: 16px;
}

button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.error {
    color: red;
    font-weight: bold;
}

.success {
    color: green;
    font-weight: bold;
}

</style>

