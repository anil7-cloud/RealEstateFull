@page "/property-statistics"

@using REAL_ESTATE_CLEAN.Core.Application.DTOs.Statistics
@using REAL_ESTATE_CLEAN.Core.Application.Services
@using REAL_ESTATE_CLEAN.Infrastructure.Auth

@inject PropertyStatisticsService StatisticsService
@inject CurrentUserService CurrentUser

<h1>📊 İlan İstatistikleri</h1>

@if (!CurrentUser.IsAuthenticated)
{
    <div class="error-box">
        İstatistikleri görmek için giriş yapmalısınız.
    </div>
}
else if (loading)
{
    <p>İstatistikler yükleniyor...</p>
}
else
{
    <div class="summary-grid">

        <div class="summary-card">
            <span>👁️</span>
            <strong>@totalViews</strong>
            <small>Toplam Görüntülenme</small>
        </div>

        <div class="summary-card">
            <span>❤️</span>
            <strong>@totalFavorites</strong>
            <small>Toplam Favori</small>
        </div>

        <div class="summary-card">
            <span>💬</span>
            <strong>@totalMessages</strong>
            <small>Gelen Mesaj</small>
        </div>

        <div class="summary-card">
            <span>📊</span>
            <strong>@(totalViews + totalFavorites + totalMessages)</strong>
            <small>Toplam Etkileşim</small>
        </div>

    </div>

    @if (statistics.Count == 0)
    {
        <div class="empty">
            Henüz ilanınız bulunmuyor.
        </div>
    }
    else
    {
        <h2>🏠 İlan Performansı</h2>

        <div class="table-container">

            <table>
                <thead>
                    <tr>
                        <th>İlan</th>
                        <th>Şehir</th>
                        <th>Fiyat</th>
                        <th>👁️ Görüntülenme</th>
                        <th>❤️ Favori</th>
                        <th>💬 Mesaj</th>
                        <th>📊 Etkileşim</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in statistics)
                    {
                        <tr>
                            <td>
                                <strong>@item.Title</strong>
                            </td>

                            <td>
                                @item.City
                            </td>

                            <td>
                                @item.Price.ToString("N0") ₺
                            </td>

                            <td>
                                @item.ViewCount
                            </td>

                            <td>
                                @item.FavoriteCount
                            </td>

                            <td>
                                @item.MessageCount
                            </td>

                            <td>
                                <strong>
                                    @item.TotalInteractions
                                </strong>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>

        <div class="top-property">

            <h2>🏆 En Çok İlgi Gören İlan</h2>

            @{
                var best = statistics
                    .OrderByDescending(x => x.TotalInteractions)
                    .FirstOrDefault();
            }

            @if (best is not null)
            {
                <div class="best-card">
                    <h3>@best.Title</h3>

                    <p>
                        📍 @best.City
                    </p>

                    <p>
                        💰 @best.Price.ToString("N0") ₺
                    </p>

                    <p>
                        👁️ @best.ViewCount görüntülenme
                    </p>

                    <p>
                        ❤️ @best.FavoriteCount favori
                    </p>

                    <p>
                        💬 @best.MessageCount mesaj
                    </p>

                    <strong>
                        📊 @best.TotalInteractions toplam etkileşim
                    </strong>
                </div>
            }

        </div>
    }
}

<style>

.summary-grid {
    display: grid;
    grid-template-columns:
        repeat(auto-fit, minmax(210px, 1fr));
    gap: 18px;
    margin: 25px 0;
}

.summary-card {
    border: 1px solid #ddd;
    border-radius: 14px;
    padding: 22px;
    background: #fafafa;
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.summary-card span {
    font-size: 28px;
}

.summary-card strong {
    font-size: 30px;
}

.summary-card small {
    color: #666;
}

.table-container {
    width: 100%;
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 18px;
    background: white;
}

th,
td {
    border: 1px solid #ddd;
    padding: 13px;
    text-align: left;
}

th {
    background: #f5f5f5;
}

.top-property {
    margin-top: 30px;
}

.best-card {
    padding: 22px;
    border: 1px solid #ddd;
    border-radius: 14px;
    background: #fafafa;
    max-width: 600px;
}

.empty,
.error-box {
    padding: 30px;
    border-radius: 12px;
    background: #f5f5f5;
}

.error-box {
    color: #b00020;
}

@@media (max-width: 700px) {

    th,
    td {
        white-space: nowrap;
    }
}

</style>

@code {

    private List<PropertyStatisticsDto> statistics = new();

    private int totalViews;
    private int totalFavorites;
    private int totalMessages;

    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!CurrentUser.IsAuthenticated)
        {
            loading = false;
            return;
        }

        var userId = CurrentUser.UserId;

        if (!userId.HasValue)
        {
            loading = false;
            return;
        }

        statistics =
            await StatisticsService.GetUserStatistics(
                userId.Value);

        totalViews =
            await StatisticsService.GetTotalViews(
                userId.Value);

        totalFavorites =
            await StatisticsService.GetTotalFavorites(
                userId.Value);

        totalMessages =
            await StatisticsService.GetTotalMessages(
                userId.Value);

        loading = false;
    }
}
