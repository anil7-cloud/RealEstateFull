                        @if (CurrentUser.IsAuthenticated)
                        {
                            <div style="margin-top:8px;">
                                @if (!image.IsCover)
                                {
                                    <button
                                        @onclick="() => SetCover(image.Id)"
                                        style="margin-right:5px;">
                                        ⭐ Kapak Yap
                                    </button>
                                }

                                <button
                                    @onclick="() => DeleteMedia(image.Id)"
                                    style="background:#dc3545;color:white;">
                                    🗑️ Sil
                                </button>
                            </div>
                        }
                    </div>
                }

            </div>
        }
        else
        {
            <div class="alert alert-secondary">
                Bu ilana henüz fotoğraf eklenmemiş.
            </div>
        }

        @if (panorama360 is not null)
        {
            <div class="mt-4 mb-4">
                <h3>🔄 360° Sanal Tur</h3>

                <div class="panorama360-container">
                    <img src="@panorama360.Url"
                         alt="360° sanal tur"
                         class="panorama360-image"
                         @ref="panoramaElement" />

                    <div class="panorama360-help">
