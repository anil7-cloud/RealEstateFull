@page "/notifications"

@using REAL_ESTATE_CLEAN.Core.Application.Services
@using REAL_ESTATE_CLEAN.Core.Persistence
@using REAL_ESTATE_CLEAN.Infrastructure.Auth

@inject NotificationService NotificationService
@inject CurrentUserService CurrentUser
@inject NavigationManager Nav

<h1>🔔 Bildirimler</h1>

@if (loading)
{
    <p>Bildirimler yükleniyor...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <p class="error">@error</p>
}
else
{
    <div class="notification-header">
        <strong>
            🔴 @unreadCount okunmamış bildirim
        </strong>

        @if (unreadCount > 0)
        {
            <button @onclick="MarkAllAsRead">
                ✓ Tümünü Okundu Yap
            </button>
        }
    </div>

    @if (notifications.Count == 0)
    {
        <div class="empty">
            <h2>🔔 Bildirim yok</h2>
            <p>Henüz size gönderilmiş bir bildirim bulunmuyor.</p>
        </div>
    }
    else
    {
        <div class="notification-list">
            @foreach (var notification in notifications)
            {
                <article class="notification-card @(notification.IsRead ? "read" : "unread")">
                    <div class="notification-icon">
                        @(notification.IsRead ? "🔔" : "🔴")
                    </div>

                    <div class="notification-content">
                        <p>@notification.Message</p>
                        <small>
                            @notification.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </small>
                    </div>

                    @if (!notification.IsRead)
                    {
                        <button
                            class="read-button"
                            @onclick="() => MarkAsRead(notification.Id)">
                            ✓ Okundu
                        </button>
                    }
                </article>
            }
        </div>
    }
}

<style>
.notification-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-bottom: 25px;
    flex-wrap: wrap;
}

.notification-header button {
    border: none;
    border-radius: 10px;
    padding: 11px 16px;
    cursor: pointer;
}

.notification-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
    max-width: 900px;
}

.notification-card {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 18px;
    border-radius: 14px;
    background: white;
    box-shadow: 0 4px 15px #ddd;
}

.notification-card.unread {
    border-left: 5px solid #2196f3;
}

.notification-card.read {
    opacity: .75;
}

.notification-icon {
    font-size: 24px;
}

.notification-content {
    flex: 1;
}

.notification-content p {
    margin: 0 0 6px;
}

.notification-content small {
    color: #777;
}

.read-button {
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    cursor: pointer;
}

.empty {
    padding: 40px;
    text-align: center;
    background: #f7f7f7;
    border-radius: 18px;
    max-width: 700px;
}

.error {
    color: red;
}

@@media (max-width: 600px) {
    .notification-card {
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .read-button {
        width: 100%;
    }
}
</style>

@code {
    private List<Notification> notifications = new();
    private int unreadCount;
    private bool loading = true;
    private string error = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!CurrentUser.IsAuthenticated)
            {
                Nav.NavigateTo("/login");
                return;
            }

            await LoadNotifications();
        }
        catch (Exception ex)
        {
            error = "Bildirimler yüklenirken hata oluştu: " + ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadNotifications()
    {
        var userId = CurrentUser.UserId!.Value;

        notifications =
            await NotificationService.GetNotifications(userId);

        unreadCount =
            await NotificationService.GetUnreadCount(userId);
    }

    private async Task MarkAsRead(int notificationId)
    {
        await NotificationService.MarkAsRead(notificationId);
        await LoadNotifications();
    }

    private async Task MarkAllAsRead()
    {
        var userId = CurrentUser.UserId!.Value;

        await NotificationService.MarkAllAsRead(userId);
        await LoadNotifications();
    }
}
