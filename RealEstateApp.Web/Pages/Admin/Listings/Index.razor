@page "/admin/leads"

@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer

@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using RealEstateApp.Web.Models

@inject AppDbContext Db
@inject AuthenticationStateProvider AuthStateProvider

<h3>Talepler</h3>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert alert-info">
        @_message
    </div>
}

@if (_isLoading)
{
    <p>Yükleniyor...</p>
}
else if (_leads.Count == 0)
{
    <div class="alert alert-warning">
        Henüz talep bulunmuyor.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped align-middle">

            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>Telefon</th>
                    <th>İlan</th>
                    <th>Durum</th>
                    <th>Tarih</th>
                    <th>İşlem</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in _leads)
                {
                    <tr>
                        <td>@item.FullName</td>

                        <td>@item.Phone</td>

                        <td>@(item.Listing?.Title ?? "-")</td>

                        <td style="min-width:160px;">
                            <InputSelect class="form-select"
                                         Value="@item.Status"
                                         ValueChanged="@(async (string value) => await UpdateStatus(item, value))"
                                         ValueExpression="@(() => item.Status)">
                                <option value="New">New</option>
                                <option value="Contacted">Contacted</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Closed">Closed</option>
                            </InputSelect>
                        </td>

                        <td>
                            @item.CreatedAt.ToLocalTime()
                        </td>

                        <td>
                            <div class="d-flex gap-2">

                                @if (!string.IsNullOrWhiteSpace(item.Listing?.Slug))
                                {
                                    <a class="btn btn-sm btn-dark"
                                       href="/listing/@item.Listing.Slug">
                                        İlan
                                    </a>
                                }

                                <a class="btn btn-sm btn-success"
                                   target="_blank"
                                   href="@GetWhatsAppUrl(item)">
                                    WhatsApp
                                </a>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>
}

@code {
    private List<Lead> _leads = new();

    private bool _isLoading = true;

    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthStateProvider.GetAuthenticationStateAsync();

        var user =
            authState.User;

        var userId =
            user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrWhiteSpace(userId))
        {
            var agency =
                await Db.Agencies
                    .FirstOrDefaultAsync(
                        x => x.IdentityUserId == userId
                    );

            if (agency is not null)
            {
                _leads =
                    await Db.Leads
                        .Include(x => x.Listing)
                        .Where(x => x.AgencyId == agency.Id)
                        .OrderByDescending(x => x.Id)
                        .ToListAsync();
            }
        }

        _isLoading = false;
    }

    private async Task UpdateStatus(
        Lead lead,
        string status)
    {
        lead.Status = status;

        await Db.SaveChangesAsync();

        _message = "Talep durumu güncellendi.";
    }

    private string GetWhatsAppUrl(Lead lead)
    {
        var phone =
            lead.Phone?
                .Replace(" ", "")
                .Replace("-", "")
                .Replace("(", "")
                .Replace(")", "")
                .Replace("+", "");

        if (string.IsNullOrWhiteSpace(phone))
        {
            return "#";
        }

        var text =
            Uri.EscapeDataString(
                "Merhaba, talebiniz hakkında dönüş sağlıyorum."
            );

        return $"https://wa.me/{phone}?text={text}";
    }
}