@page "/admin/listings"

@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer

@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using RealEstateApp.Web.Models

@inject AppDbContext Db
@inject AuthenticationStateProvider AuthStateProvider

<h3>İlan Yönetimi</h3>

<div class="mb-3">
    <a class="btn btn-success"
       href="/admin/listings/add">
        Yeni İlan Ekle
    </a>
</div>

@if (_isLoading)
{
    <p>Yükleniyor...</p>
}
else if (_agency is null)
{
    <div class="alert alert-warning">
        Önce emlak ofisi oluşturmalısınız.
    </div>

    <a class="btn btn-dark"
       href="/admin/agency/create">
        Ofis Oluştur
    </a>
}
else if (_listings.Count == 0)
{
    <div class="alert alert-warning">
        Henüz ilan yok.
    </div>
}
else
{
    <table class="table table-bordered table-striped align-middle">
        <thead>
            <tr>
                <th>Görsel</th>
                <th>Başlık</th>
                <th>Fiyat</th>
                <th>Şehir</th>
                <th>İlçe</th>
                <th>Durum</th>
                <th>Lead</th>
                <th>İşlem</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var listing in _listings)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(listing.CoverImageUrl))
                        {
                            <img src="@listing.CoverImageUrl"
                                 style="width:100px; height:70px; object-fit:cover; border-radius:6px;" />
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>

                    <td>@listing.Title</td>

                    <td>@listing.Price.ToString("N0") ₺</td>

                    <td>@listing.City</td>

                    <td>@listing.District</td>

                    <td>@listing.Status</td>

                    <td>
                        @GetLeadCount(listing.Id)
                    </td>

                    <td>
                        <div class="d-flex gap-2 flex-wrap">

                            <a class="btn btn-dark btn-sm"
                               href="/listing/@listing.Slug">
                                Gör
                            </a>

                            <a class="btn btn-warning btn-sm"
                               href="/admin/listings/edit/@listing.Id">
                                Düzenle
                            </a>

                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    @onclick="() => ToggleStatus(listing)">
                                @(listing.Status == "Active" ? "Pasif Yap" : "Aktif Yap")
                            </button>

                            <button type="button"
                                    class="btn btn-danger btn-sm"
                                    @onclick="() => DeleteListing(listing.Id)">
                                Sil
                            </button>

                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private RealEstateApp.Web.Models.Agency? _agency;

    private List<Listing> _listings = new();

    private Dictionary<int, int> _leadCounts = new();

    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var authState =
            await AuthStateProvider.GetAuthenticationStateAsync();

        var user =
            authState.User;

        var userId =
            user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrWhiteSpace(userId))
        {
            _agency =
                await Db.Agencies
                    .FirstOrDefaultAsync(x => x.IdentityUserId == userId);

            if (_agency is not null)
            {
                _listings =
                    await Db.Listings
                        .Where(x => x.AgencyId == _agency.Id)
                        .OrderByDescending(x => x.Id)
                        .ToListAsync();

                _leadCounts =
                    await Db.Leads
                        .Where(x => x.AgencyId == _agency.Id)
                        .GroupBy(x => x.ListingId)
                        .Select(x => new
                        {
                            ListingId = x.Key,
                            Count = x.Count()
                        })
                        .ToDictionaryAsync(x => x.ListingId, x => x.Count);
            }
        }

        _isLoading = false;
    }

    private int GetLeadCount(int listingId)
    {
        return _leadCounts.TryGetValue(listingId, out var count)
            ? count
            : 0;
    }

    private async Task ToggleStatus(Listing listing)
    {
        listing.Status =
            listing.Status == "Active"
                ? "Passive"
                : "Active";

        await Db.SaveChangesAsync();
    }

    private async Task DeleteListing(int id)
    {
        var listing =
            await Db.Listings
                .Include(x => x.Images)
                .FirstOrDefaultAsync(x => x.Id == id);

        if (listing is null)
            return;

        var leads =
            await Db.Leads
                .Where(x => x.ListingId == id)
                .ToListAsync();

        Db.Leads.RemoveRange(leads);
        Db.ListingImages.RemoveRange(listing.Images);
        Db.Listings.Remove(listing);

        await Db.SaveChangesAsync();

        await LoadData();
    }
}