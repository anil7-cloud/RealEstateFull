@page "/listings/search"

@using Microsoft.EntityFrameworkCore
@using RealEstateApp.Web.Models

@inject AppDbContext Db

<h3>İlan Ara</h3>

<div class="row mb-4">

    <div class="col-md-4">

        <InputText class="form-control"
                   placeholder="Şehir"
                   @bind-Value="_city" />

    </div>

    <div class="col-md-4">

        <InputNumber class="form-control"
                     placeholder="Minimum Fiyat"
                     @bind-Value="_minPrice" />

    </div>

    <div class="col-md-4">

        <button class="btn btn-dark w-100"
                @onclick="SearchListings">
            Ara
        </button>

    </div>

</div>

@if (_isLoading)
{
    <p>Yükleniyor...</p>
}
else if (_listings.Count == 0)
{
    <div class="alert alert-warning">
        Sonuç bulunamadı.
    </div>
}
else
{
    <div class="row">

        @foreach (var item in _listings)
        {
            <div class="col-md-4 mb-4">

                <div class="card shadow-sm h-100">

                    @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                    {
                        <img src="@item.CoverImageUrl"
                             class="card-img-top"
                             style="height:240px; object-fit:cover;" />
                    }

                    <div class="card-body">

                        <h5>
                            @item.Title
                        </h5>

                        <p class="fw-bold fs-5">
                            @item.Price.ToString("N0") ₺
                        </p>

                        <p>
                            @item.City / @item.District
                        </p>

                        <a class="btn btn-dark w-100"
                           href="/listing/@item.Slug">
                            Detay
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>
}

@code {

    private List<Listing> _listings = new();

    private bool _isLoading = true;

    private string? _city;

    private decimal? _minPrice;

    protected override async Task OnInitializedAsync()
    {
        await SearchListings();
    }

    private async Task SearchListings()
    {
        _isLoading = true;

        var query =
            Db.Listings
                .Where(x => x.Status == "Active")
                .AsQueryable();

        if (!string.IsNullOrWhiteSpace(_city))
        {
            query =
                query.Where(
                    x => x.City!.Contains(_city)
                );
        }

        if (_minPrice.HasValue)
        {
            query =
                query.Where(
                    x => x.Price >= _minPrice.Value
                );
        }

        _listings =
            await query
                .OrderByDescending(x => x.Id)
                .ToListAsync();

        _isLoading = false;
    }
}