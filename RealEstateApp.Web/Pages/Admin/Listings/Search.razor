@page "/listings/search"

@using Microsoft.EntityFrameworkCore
@using RealEstateApp.Web.Models

@inject AppDbContext Db

<h3>İlan Ara</h3>

<div class="card mb-4">
    <div class="card-body">

        <div class="row">

            <div class="col-md-3 mb-3">
                <label>Şehir</label>
                <InputText class="form-control"
                           @bind-Value="_city" />
            </div>

            <div class="col-md-3 mb-3">
                <label>İlçe</label>
                <InputText class="form-control"
                           @bind-Value="_district" />
            </div>

            <div class="col-md-3 mb-3">
                <label>Minimum Fiyat</label>
                <InputNumber class="form-control"
                             @bind-Value="_minPrice" />
            </div>

            <div class="col-md-3 mb-3">
                <label>Maksimum Fiyat</label>
                <InputNumber class="form-control"
                             @bind-Value="_maxPrice" />
            </div>

            <div class="col-md-3 mb-3">
                <label>Oda Sayısı</label>
                <InputNumber class="form-control"
                             @bind-Value="_roomCount" />
            </div>

            <div class="col-md-3 mb-3">
                <label>Sıralama</label>

                <InputSelect class="form-select"
                             @bind-Value="_sortBy">

                    <option value="newest">
                        En Yeni
                    </option>

                    <option value="priceAsc">
                        Fiyat Artan
                    </option>

                    <option value="priceDesc">
                        Fiyat Azalan
                    </option>

                </InputSelect>

            </div>

            <div class="col-md-3 d-flex align-items-end mb-3">

                <button class="btn btn-dark w-100"
                        @onclick="SearchListings">
                    Ara
                </button>

            </div>

            <div class="col-md-3 d-flex align-items-end mb-3">

                <button class="btn btn-outline-secondary w-100"
                        @onclick="ClearFilters">
                    Temizle
                </button>

            </div>

        </div>

    </div>
</div>

@if (_isLoading)
{
    <p>Yükleniyor...</p>
}
else
{
    <p class="mb-3">
        <strong>@_listings.Count</strong> sonuç bulundu.
    </p>

    @if (_listings.Count == 0)
    {
        <div class="alert alert-warning">
            Sonuç bulunamadı.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var item in _listings)
            {
                <div class="col-md-4 mb-4">

                    <div class="card shadow-sm h-100">

                        @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                        {
                            <img src="@item.CoverImageUrl"
                                 class="card-img-top"
                                 style="height:240px; object-fit:cover;" />
                        }

                        <div class="card-body">

                            <h5>
                                @item.Title
                            </h5>

                            <p class="fw-bold fs-5 text-primary">
                                @item.Price.ToString("N0") ₺
                            </p>

                            <p>
                                @item.City / @item.District
                            </p>

                            <p>
                                @item.RoomCount Oda -
                                @item.GrossM2 m²
                            </p>

                            <a class="btn btn-dark w-100"
                               href="/listing/@item.Slug">
                                Detay
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
}

@code {

    private List<Listing> _listings = new();

    private bool _isLoading = true;

    private string? _city;

    private string? _district;

    private decimal? _minPrice;

    private decimal? _maxPrice;

    private int? _roomCount;

    private string _sortBy = "newest";

    protected override async Task OnInitializedAsync()
    {
        await SearchListings();
    }

    private async Task SearchListings()
    {
        _isLoading = true;

        var query =
            Db.Listings
                .Where(x => x.Status == "Active")
                .AsQueryable();

        if (!string.IsNullOrWhiteSpace(_city))
        {
            query =
                query.Where(
                    x => x.City!.Contains(_city)
                );
        }

        if (!string.IsNullOrWhiteSpace(_district))
        {
            query =
                query.Where(
                    x => x.District!.Contains(_district)
                );
        }

        if (_minPrice.HasValue)
        {
            query =
                query.Where(
                    x => x.Price >= _minPrice.Value
                );
        }

        if (_maxPrice.HasValue)
        {
            query =
                query.Where(
                    x => x.Price <= _maxPrice.Value
                );
        }

        if (_roomCount.HasValue)
        {
            query =
                query.Where(
                    x => x.RoomCount == _roomCount.Value
                );
        }

        query = _sortBy switch
        {
            "priceAsc" => query.OrderBy(x => x.Price),
            "priceDesc" => query.OrderByDescending(x => x.Price),
            _ => query.OrderByDescending(x => x.Id)
        };

        _listings =
            await query.ToListAsync();

        _isLoading = false;
    }

    private async Task ClearFilters()
    {
        _city = null;
        _district = null;
        _minPrice = null;
        _maxPrice = null;
        _roomCount = null;
        _sortBy = "newest";

        await SearchListings();
    }
}