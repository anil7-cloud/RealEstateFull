@page "/profile"

@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using RealEstateApp.Web.Models

@inject AuthenticationStateProvider AuthStateProvider
@inject AppDbContext Db
@inject NavigationManager Nav

<h3>Profil</h3>

@if (!_loaded)
{
    <p>Yükleniyor...</p>
}
else
{
    <div class="card">
        <div class="card-body">

            <p>
                <strong>Kullanıcı ID:</strong>
                @_userId
            </p>

            <p>
                <strong>Email:</strong>
                @_email
            </p>

            <p>
                <strong>Kullanıcı:</strong>
                @_userName
            </p>

            <hr />

            @if (_agency is null)
            {
                <div class="alert alert-warning">
                    Bu kullanıcıya bağlı emlak ofisi bulunamadı.
                </div>

                <a class="btn btn-dark"
                   href="/admin/agency/create">
                    Emlak Ofisi Oluştur
                </a>
            }
            else
            {
                <h5>Ajans Bilgisi</h5>

                <p>
                    <strong>Ajans:</strong>
                    @_agency.Name
                </p>

                <p>
                    <strong>Şehir:</strong>
                    @_agency.City
                </p>

                <p>
                    <strong>İlçe:</strong>
                    @_agency.District
                </p>

                <p>
                    <strong>Telefon:</strong>
                    @_agency.Phone
                </p>

                <div class="d-flex gap-2">
                    <a class="btn btn-dark"
                       href="@GetAgencyUrl()">
                        Ajansa Git
                    </a>

                    <a class="btn btn-primary"
                       href="/admin/dashboard">
                        Admin Panel
                    </a>
                </div>
            }

        </div>
    </div>
}

@code {
    private string? _userId;
    private string? _email;
    private string? _userName;

    private RealEstateApp.Web.Models.Agency? _agency;

    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthStateProvider
                .GetAuthenticationStateAsync();

        var user =
            authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            _userId =
                user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            _email =
                user.FindFirst(ClaimTypes.Email)?.Value;

            _userName =
                user.Identity.Name;

            if (!string.IsNullOrWhiteSpace(_userId))
            {
                _agency =
                    await Db.Agencies
                        .FirstOrDefaultAsync(
                            x => x.IdentityUserId == _userId
                        );
            }
        }

        _loaded = true;
    }

    private string GetAgencyUrl()
    {
        if (_agency is null ||
            string.IsNullOrWhiteSpace(_agency.Slug))
        {
            return "/profile";
        }

        return $"/agency/{_agency.Slug}";
    }
}