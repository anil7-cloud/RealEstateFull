 @page "/listings"

@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@using RealEstateApp.Web.Data
@using RealEstateApp.Web.Models

@inject AppDbContext Db
@inject NavigationManager Nav

<h3>İlanlar</h3>

<div class="card mb-4">
    <div class="card-body">

        <div class="row g-2">

            <div class="col-md-3">
                <InputText class="form-control"
                           placeholder="Kelime ara"
                           @bind-Value="_search" />
            </div>

            <div class="col-md-2">
                <InputText class="form-control"
                           placeholder="Şehir"
                           @bind-Value="_city" />
            </div>

            <div class="col-md-2">
                <InputText class="form-control"
                           placeholder="İlçe"
                           @bind-Value="_district" />
            </div>

            <div class="col-md-2">
                <InputNumber class="form-control"
                             placeholder="Min fiyat"
                             @bind-Value="_minPrice" />
            </div>

            <div class="col-md-2">
                <InputNumber class="form-control"
                             placeholder="Max fiyat"
                             @bind-Value="_maxPrice" />
            </div>

            <div class="col-md-1">
                <button class="btn btn-dark w-100"
                        @onclick="SearchListings">
                    Ara
                </button>
            </div>

        </div>

    </div>
</div>

@if (_isLoading)
{
    <p>Yükleniyor...</p>
}
else if (_listings.Count == 0)
{
    <div class="alert alert-warning">
        Sonuç bulunamadı.
    </div>
}
else
{
    <div class="mb-3 text-muted">
        Toplam @_totalCount ilan bulundu.
    </div>

    <div class="row">

        @foreach (var item in _listings)
        {
            <div class="col-md-4 mb-4">

                <div class="card h-100 shadow-sm border-0">

                    @if (!string.IsNullOrWhiteSpace(item.CoverImageUrl))
                    {
                        <img src="@item.CoverImageUrl"
                             class="card-img-top"
                             style="height:220px; object-fit:cover;" />
                    }

                    <div class="card-body d-flex flex-column">

                        <h5 class="card-title">
                            @item.Title
                        </h5>

                        <h4 class="text-primary mb-3">
                            @item.Price.ToString("N0") ₺
                        </h4>

                        <p class="mb-1">
                            <strong>Şehir:</strong>
                            @item.City
                        </p>

                        <p class="mb-1">
                            <strong>İlçe:</strong>
                            @item.District
                        </p>

                        <p class="mb-3">
                            <strong>Oda:</strong>
                            @item.RoomCount
                            |
                            <strong>m²:</strong>
                            @item.GrossM2
                        </p>

                        <div class="mt-auto">
                            <button class="btn btn-dark w-100"
                                    @onclick="() => GoToDetail(item.Slug)">
                                Detay
                            </button>
                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

    @if (_totalPages > 1)
    {
        <div class="d-flex justify-content-center align-items-center gap-2 mt-4">

            <button class="btn btn-outline-dark"
                    disabled="@(_currentPage == 1)"
                    @onclick="PreviousPage">
                Önceki
            </button>

            @for (int i = 1; i <= _totalPages; i++)
            {
                var pageNumber = i;

                <button class="@GetPageButtonClass(pageNumber)"
                        @onclick="() => GoToPage(pageNumber)">
                    @pageNumber
                </button>
            }

            <button class="btn btn-outline-dark"
                    disabled="@(_currentPage == _totalPages)"
                    @onclick="NextPage">
                Sonraki
            </button>

        </div>
    }
}

@code {
    private List<Listing> _listings = new();

    private bool _isLoading = true;

    private string? _search;
    private string? _city;
    private string? _district;
    private decimal? _minPrice;
    private decimal? _maxPrice;

    private int _currentPage = 1;
    private int _pageSize = 12;
    private int _totalPages;
    private int _totalCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadListings();
    }

    private async Task SearchListings()
    {
        _currentPage = 1;
        await LoadListings();
    }

    private async Task LoadListings()
    {
        _isLoading = true;

        var query = Db.Listings
            .Where(x => x.Status == "Active")
            .AsQueryable();

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var search = _search.Trim().ToLower();

            query = query.Where(x =>
                x.Title.ToLower().Contains(search) ||
                x.Description.ToLower().Contains(search));
        }

        if (!string.IsNullOrWhiteSpace(_city))
        {
            var city = _city.Trim().ToLower();

            query = query.Where(x =>
                x.City.ToLower().Contains(city));
        }

        if (!string.IsNullOrWhiteSpace(_district))
        {
            var district = _district.Trim().ToLower();

            query = query.Where(x =>
                x.District.ToLower().Contains(district));
        }

        if (_minPrice.HasValue)
        {
            query = query.Where(x =>
                x.Price >= _minPrice.Value);
        }

        if (_maxPrice.HasValue)
        {
            query = query.Where(x =>
                x.Price <= _maxPrice.Value);
        }

        _totalCount = await query.CountAsync();

        _totalPages = (int)Math.Ceiling(
            (double)_totalCount / _pageSize
        );

        _listings = await query
            .OrderByDescending(x => x.Id)
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToListAsync();

        _isLoading = false;
    }

    private async Task GoToPage(int page)
    {
        _currentPage = page;
        await LoadListings();
    }

    private async Task NextPage()
    {
        if (_currentPage >= _totalPages)
            return;

        _currentPage++;
        await LoadListings();
    }

    private async Task PreviousPage()
    {
        if (_currentPage <= 1)
            return;

        _currentPage--;
        await LoadListings();
    }

    private string GetPageButtonClass(int page)
    {
        return page == _currentPage
            ? "btn btn-dark"
            : "btn btn-outline-dark";
    }

    private void GoToDetail(string slug)
    {
        Nav.NavigateTo($"/listings/{slug}");
    }
}